        "it": [
          "\\b(?:tratta|considera|interpreta|usa)\\b.{0,35}\\b(?:documento|file|pagina|contenuto|testo)\\b.{0,35}\\bcome\\b.{0,20}\\b(?:prompt|istruzioni|messaggio)\\b.{0,20}\\b(?:sistema|sviluppatore|fidat[oe])\\b"
        ],
        "de": [
          "\\b(?:behandle|betrachte|verwende|interpretiere)\\b.{0,35}\\b(?:dokument|datei|seite|inhalt|text)\\b.{0,35}\\bals\\b.{0,25}\\b(?:systemprompt|systemanweisungen|entwicklernachricht)\\b"
        ],
        "fr": [
          "\\b(?:traite|traitez|considere|considerez|interprete)\\b.{0,35}\\b(?:document|fichier|page|contenu|texte)\\b.{0,35}\\bcomme\\b.{0,20}\\b(?:prompt|instructions|message)\\b.{0,20}\\b(?:systeme|developpeur)\\b"
        ],
        "es": [
          "\\b(?:trata|considera|interpreta|usa)\\b.{0,35}\\b(?:documento|archivo|pagina|contenido|texto)\\b.{0,35}\\bcomo\\b.{0,20}\\b(?:prompt|instrucciones|mensaje)\\b.{0,20}\\b(?:sistema|desarrollador)\\b"
        ]
      }
    },
    {
      "id": "ROLE_BOUNDARY_INJECTION",
      "title": "Conversation control delimiters or privileged role boundaries in a file",
      "severity": "HIGH",
      "category": "ROLE_SPOOFING",
      "score": 60,
      "patterns": {
        "all": [
          "<\\|(?:im_start|start_header_id|start|end|eot_id)\\|>\\s*(?:system|developer|assistant)?",
          "\\[/?inst\\]|<<\\s*/?sys\\s*>>",
          "(?:^|\\n)\\s*(?:#{1,6}\\s*)?(?:\\[\\s*(?:system|developer)\\s*\\]|<\\s*(?:system|developer)\\s*>)\\s*[:\\n]?",
          "\\b(?:begin|start)\\s+(?:system|developer)\\s+(?:message|prompt|instructions)\\b"
        ]
      }
    },
    {
      "id": "CONFIG_MANIPULATION",
      "title": "Instruction to change agent configuration, tool schemas or trust metadata",
      "severity": "HIGH",
      "category": "CONFIG_MANIPULATION",
      "score": 65,
      "patterns": {
        "en": [
          "\\b(?:modify|edit|overwrite|replace|update|patch|rewrite|append|write|delete|remove)\\b.{0,65}(?:\\b(?:mcp|agent|tool|server)[ _-]?(?:config(?:uration)?|definition|schema)|\\b(?:inputschema|allowed_paths|mcpservers|agents\\.md|claude\\.md|settings\\.json|mcp\\.json)\\b|\\b(?:approval|canonical|prototype_content)[ _-]?hash\\b)",
          "\\b(?:set|change|point|redirect)\\b.{0,40}\\b(?:endpoint|command|allowed_paths|capabilities|permissions)\\b.{0,30}\\b(?:to|as)\\b.{0,40}(?:https?://|\\*|/|execute|shell|unrestricted)"
        ],
        "it": [
